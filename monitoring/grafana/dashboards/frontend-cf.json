{
  "uid": "frontend-cf",
  "title": "Frontend - Cloudflare Worker (byeoldori-web)",
  "tags": ["byeoldori", "frontend", "cloudflare"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Worker 요청 수 (req/min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (script_name) (rate(cloudflare_worker_requests_count[10m]) * 60)",
          "legendFormat": "{{script_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Worker 에러 수 / 에러율",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "에러율 %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (script_name) (rate(cloudflare_worker_errors_count[10m]) * 60)",
          "legendFormat": "errors {{script_name}}"
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(cloudflare_worker_errors_count[10m])) / clamp_min(sum(rate(cloudflare_worker_requests_count[10m])), 1e-10)",
          "legendFormat": "에러율 %"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Zone HTTP 상태코드 (byeoldori.com, req/min)",
      "description": "Worker 자체는 상태코드 분해를 제공하지 않아 Zone 애널리틱스 기준. Zone Analytics:Read 권한 필요.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 35, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(cloudflare_zone_requests_status[10m]) * 60)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Worker CPU time 분위수 (µs)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudflare_worker_cpu_time{quantile=~\"P50|P75|P99\"}",
          "legendFormat": "{{script_name}} {{quantile}}"
        }
      ]
    }
  ]
}
