{
  "uid": "backend-overview",
  "title": "Backend - Overview (Spring Boot)",
  "tags": ["byeoldori", "backend", "spring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP 요청 처리율 (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"byeoldori-app\"}[5m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx 비율 (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"byeoldori-app\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"byeoldori-app\"}[5m])), 1e-10)",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 응답 지연 (초)",
      "description": "histogram_quantile은 앱에 management.metrics.distribution.percentiles-histogram.http.server.requests=true 설정 후 데이터가 표시됨. 그 전까지는 max(실측) 시리즈만 표시.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"byeoldori-app\"}[5m])))",
          "legendFormat": "p95 전체"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"byeoldori-app\"}[5m])))",
          "legendFormat": "p50 전체"
        },
        {
          "refId": "C",
          "expr": "max(http_server_requests_seconds_max{job=\"byeoldori-app\"})",
          "legendFormat": "max(실측)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM 힙 메모리",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (color) (jvm_memory_used_bytes{job=\"byeoldori-app\", area=\"heap\"})",
          "legendFormat": "used ({{color}})"
        },
        {
          "refId": "B",
          "expr": "sum by (color) (jvm_memory_max_bytes{job=\"byeoldori-app\", area=\"heap\"})",
          "legendFormat": "max ({{color}})"
        }
      ]
    }
  ]
}
