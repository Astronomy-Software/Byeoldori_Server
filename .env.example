# 운영 VM ~/byeoldori-server/.env 에 필요한 값(이름만). 실제 값은 레포에 두지 않는다.
# 로컬 백업: ~/.oci/byeoldori_secrets_backup.env

# DB
MYSQL_ROOT_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_URI=

# 인증
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 외부 API
WEATHER_API_KEY=
WEATHER_API_URL=

# 메일(Gmail 앱 비밀번호)
MAIL_USERNAME=
MAIL_PASSWORD=

# 공개 주소
PUBLIC_BASE_URL=https://api.byeoldori.com
APP_HOST_URL=https://api.byeoldori.com
# 선택. 비우면 application.properties 기본값(localhost)을 쓴다
CORS_ALLOWED_ORIGINS=
