# 운영 VM ~/byeoldori-server/.env 에 필요한 값(이름만). 실제 값은 레포에 두지 않는다.
# 로컬 백업: ~/.oci/byeoldori_secrets_backup.env

# DB
MYSQL_ROOT_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_URI=

# 인증
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 외부 API
WEATHER_API_KEY=
WEATHER_API_URL=

# 메일(Gmail 앱 비밀번호)
MAIL_USERNAME=
MAIL_PASSWORD=
# 선택: 보내는 주소(From). 줄을 아예 빼면 noreply@byeoldori.com (빈 값으로 두면 From 이 비므로 주의). Gmail "다른 주소로 보내기"에 등록된 주소여야 그대로 나감
# MAIL_FROM=noreply@byeoldori.com

# 공개 주소
PUBLIC_BASE_URL=https://api.byeoldori.com
APP_HOST_URL=https://api.byeoldori.com
# 선택. 비우면 application.properties 기본값(localhost)을 쓴다
CORS_ALLOWED_ORIGINS=

# 선택: 웹 프록시(Cloudflare Worker)와 같은 값. 웹 쪽은 wrangler secret put PROXY_SHARED_SECRET 로 넣는다.
# 비우면 웹 사용자 IP 헤더를 믿지 않아 웹 트래픽 전체가 Worker IP 하나로 레이트리밋된다(예전과 같음)
# PROXY_SHARED_SECRET=
